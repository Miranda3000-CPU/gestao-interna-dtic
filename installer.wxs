<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <!-- Instalador Per-User (sem exigir admin) -->
  <Product
    Id="*"
    Name="Gestão Interna DTIC"
    Manufacturer="CBMPA - DTIC"
    Version="2.0.0"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
    Language="1046">

    <Package
      InstallerVersion="200"
      Compressed="yes"
      InstallScope="perUser"
      Comments="Sistema de Gestao de Pessoal - CBMPA/DTIC" />

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente já está instalada." />

    <Media Id="1" Cabinet="gestao.cab" EmbedCab="yes" />

    <!-- Ícone do app -->
    <Icon Id="app.ico" SourceFile="public/img/icon.ico" />

    <!-- Pasta: %LOCALAPPDATA%\Programs\GestaoDTIC -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="GestaoDTIC">

            <Component Id="MainExe" Guid="C1B2A3D4-E5F6-7890-ABCD-EF1234567890">
              <File Id="ExeFile" Name="GestaoInternaDTIC.exe" Source="dist/GestaoInternaDTIC.exe" KeyPath="yes" />
              <Shortcut
                Id="StartMenuShortcut"
                Directory="ProgramMenuDir"
                Name="Gestão Interna DTIC"
                WorkingDirectory="INSTALLDIR"
                Icon="app.ico" />
              <Shortcut
                Id="DesktopShortcut"
                Directory="DesktopFolder"
                Name="Gestão Interna DTIC"
                WorkingDirectory="INSTALLDIR"
                Icon="app.ico" />
            </Component>

          </Directory>
        </Directory>
      </Directory>

      <!-- Menu Iniciar -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="Gestão Interna DTIC" />
      </Directory>

      <!-- Área de Trabalho -->
      <Directory Id="DesktopFolder" />
    </Directory>

    <!-- Feature -->
    <Feature Id="MainFeature" Title="Gestão Interna DTIC" Level="1">
      <ComponentRef Id="MainExe" />
    </Feature>

  </Product>
</Wix>